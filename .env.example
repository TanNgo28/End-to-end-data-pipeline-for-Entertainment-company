# Run scripts/init_env.sh to create .env with unique random local credentials.
# Never commit .env. It is listed in .gitignore.
# If you write .env by hand, fill every empty value before starting Compose.
COMPOSE_PROJECT_NAME=entertainment-lakehouse
# Host ports bind to 127.0.0.1 only. Use different ports for a second QA project.
FLINK_PORT=8081
TRINO_PORT=8080
# The tools container runs as this host user so .runtime stays writable.
LOCAL_UID=1000
LOCAL_GID=1000
# SeaweedFS S3 / Iceberg REST signing credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Oracle SYS/SYSTEM password and the analytics account read by Trino.
# ORACLE_ANALYTICS_PASSWORD must be 12-64 characters from [A-Za-z0-9_#].
ORACLE_PWD=
ORACLE_ANALYTICS_PASSWORD=
