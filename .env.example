# Run scripts/init_env.sh to create .env with unique local credentials.
# If editing manually, set every empty credential before starting Compose.
COMPOSE_PROJECT_NAME=entertainment-lakehouse
FLINK_PORT=8081
TRINO_PORT=8080
LOCAL_UID=1000
LOCAL_GID=1000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ORACLE_PWD=
ORACLE_ANALYTICS_PASSWORD=
