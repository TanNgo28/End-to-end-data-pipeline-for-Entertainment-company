table 'Customer Profiles'
	lineageTag: 0802d8bb-a73a-4da6-9848-f43aa89459be

	measure 'Demo Customers' = DISTINCTCOUNT('Customer Profiles'[Customer ID])
		formatString: #,0
		lineageTag: dc33d449-68d9-40db-89e5-2710b5e4dca4

	measure 'Cross-service Customers' = COUNTROWS(FILTER('Customer Profiles', 'Customer Profiles'[Streaming Events] > 0 && 'Customer Profiles'[Confirmed] > 0))
		formatString: #,0
		lineageTag: 5b08e0d8-68e5-4047-85cb-58e7a499b9c9

	measure 'Customer Watch Minutes' = DIVIDE(SUM('Customer Profiles'[Watch Seconds]), 60)
		formatString: #,0.00
		lineageTag: ceede449-7bec-4410-854d-87d2793e39b3

	measure 'Customer Bookings' = SUM('Customer Profiles'[Bookings])
		formatString: #,0
		lineageTag: 17bd1f82-f93e-4231-b1db-6722a168dcd6

	measure 'Customer Spend VND' = SUM('Customer Profiles'[Net Spend VND])
		formatString: #,0
		lineageTag: 72110fd4-db3d-4751-bc2f-64ac42152714

	measure 'Customer Plays' = SUM('Customer Profiles'[Plays])
		formatString: #,0
		lineageTag: 20318b3d-15f3-4286-8737-f7177a665769

	measure 'Customer Check-ins' = SUM('Customer Profiles'[Check Ins])
		formatString: #,0
		lineageTag: de5a13ca-e3c7-44c5-bf5f-41a43bef72ef

	measure 'Customer Check-in Rate' = DIVIDE([Customer Check-ins], SUM('Customer Profiles'[Confirmed]))
		formatString: 0.0%
		lineageTag: d4408604-2518-4eac-9253-764543a61b72

	measure 'Avg Spend per Customer VND' = DIVIDE([Customer Spend VND], [Demo Customers])
		formatString: #,0
		lineageTag: e3a24fe3-53a2-4674-9d5c-a718dab0a69c

	measure 'Avg Watch Minutes per Customer' = DIVIDE([Customer Watch Minutes], [Demo Customers])
		formatString: #,0.00
		lineageTag: cd33874b-e39a-48e6-988b-bbb4b7cbd753

	column 'Customer ID'
		dataType: string
		lineageTag: c301654d-5218-4404-9ad0-3f0c565f88b2
		summarizeBy: none
		sourceColumn: customer_id

	column Membership
		dataType: string
		lineageTag: 607edb24-f2cd-4342-9db2-7a1301b64950
