				    Typed = Table.TransformColumnTypes(Source, {{"customer_id", type text}, {"membership", type text}, {"last_stream_utc", type text}, {"streaming_events", Int64.Type}, {"plays", Int64.Type}, {"watch_seconds", Int64.Type}, {"bookings", Int64.Type}, {"confirmed", Int64.Type}, {"net_spend_vnd", Int64.Type}, {"check_ins", Int64.Type}}, "en-US")
