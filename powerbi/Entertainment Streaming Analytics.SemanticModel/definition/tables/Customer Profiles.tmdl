	partition 'Customer Profiles' = m
		mode: import
		source =
				let
				    Source = ReadGold("customer_360", "SELECT customer_id, membership, last_stream_utc, CAST(streaming_events AS BIGINT) AS streaming_events, CAST(plays AS BIGINT) AS plays, CAST(watch_seconds AS BIGINT) AS watch_seconds, CAST(bookings AS BIGINT) AS bookings, CAST(confirmed AS BIGINT) AS confirmed, CAST(net_spend_vnd AS BIGINT) AS net_spend_vnd, CAST(check_ins AS BIGINT) AS check_ins FROM oracle.entertainment_analytics.customer_360 ORDER BY customer_id", {"customer_id", "membership", "last_stream_utc", "streaming_events", "plays", "watch_seconds", "bookings", "confirmed", "net_spend_vnd", "check_ins"}, {{"usr_demo_001", "Premium", "2026-11-15 19:00:48", 9, 2, 339, 5, 2, 900000, 1}, {"usr_demo_002", "Standard", "2026-11-15 19:03:43", 7, 2, 478, 4, 4, 1130000, 3}, {"usr_demo_003", "Free", "2026-11-15 19:02:33", 9, 2, 621, 3, 3, 1240000, 2}, {"usr_demo_004", "Premium", "2026-11-14 19:00:40", 8, 5, 607, 6, 4, 1660000, 4}, {"usr_demo_005", "Standard", "2026-11-15 19:00:13", 13, 5, 540, 4, 2, 530000, 2}, {"usr_demo_006", "Free", "2026-11-12 19:02:44", 1, 0, 32, 3, 3, 1240000, 3}, {"usr_demo_007", "Premium", "2026-11-15 19:03:50", 14, 3, 1182, 6, 4, 1130000, 2}, {"usr_demo_008", "Standard", "2026-11-15 19:03:22", 13, 5, 628, 5, 2, 600000, 2}, {"usr_demo_009", "Free", "2026-11-15 19:01:30", 8, 1, 506, 3, 3, 1240000, 2}, {"usr_demo_010", "Premium", "2026-11-14 19:03:00", 9, 4, 650, 5, 5, 1870000, 5}, {"usr_demo_011", "Standard", "2026-11-15 19:02:05", 4, 1, 184, 5, 3, 1110000, 3}, {"usr_demo_012", "Free", "2026-11-14 19:01:08", 6, 3, 351, 3, 1, 340000, 1}, {"usr_demo_013", "Premium", "2026-11-15 19:03:01", 13, 3, 803, 5, 5, 1870000, 4}, {"usr_demo_014", "Standard", "2026-11-14 19:02:18", 5, 0, 404, 4, 3, 1320000, 2}, {"usr_demo_015", "Free", "2026-11-15 19:00:06", 2, 1, 0, 4, 2, 900000, 2}, {"usr_demo_016", "Premium", "2026-11-15 19:03:15", 12, 5, 711, 5, 4, 1220000, 3}, {"usr_demo_017", "Standard", "2026-11-11 19:03:11", 3, 1, 221, 4, 4, 1600000, 3}, {"usr_demo_018", "F