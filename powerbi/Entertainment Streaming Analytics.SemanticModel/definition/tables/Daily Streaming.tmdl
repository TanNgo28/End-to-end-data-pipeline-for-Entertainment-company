table 'Daily Streaming'
	lineageTag: fa55c473-45d9-4289-b22a-48685948955d

	measure 'Daily Plays' = SUM('Daily Streaming'[Play Count])
		formatString: #,0
		lineageTag: d2dde04b-fb47-42b0-b6af-c4bf66a70dee

	measure 'Daily Watch Time (min)' = DIVIDE(SUM('Daily Streaming'[Watch Seconds]), 60)
		formatString: #,0.00
		lineageTag: 6a34da80-ca91-4da1-bba6-8f55b6566a0c

	measure 'Watch Minutes per Play' = DIVIDE([Daily Watch Time (min)], [Daily Plays])
		formatString: #,0.00
		lineageTag: bdfc07c9-0613-4eb0-9837-1727c028629c

	column 'UTC Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: a586f68b-fbf2-4114-a7ae-b268bf4586cf
		summarizeBy: none
		sourceColumn: event_date

		annotation UnderlyingDateTimeDataType = Date

	column 'Play Count'
		dataType: int64
		isHidden
		lineageTag: d22e257b-6db1-4e0a-9e41-edead0dd05cf
		summarizeBy: none
		sourceColumn: play_count

	column 'Watch Seconds'
		dataType: int64
		isHidden
		lineageTag: 1fc127f9-b224-45a9-8439-5033f9b6d882
		summarizeBy: none
		sourceColumn: total_watch_seconds

	partition 'Daily Streaming' = m
		mode: import
		source =
				let
				    Source = ReadGold("daily_streaming_trends", "SELECT event_date, CAST(play_count AS BIGINT) AS play_count, CAST(total_watch_seconds AS BIGINT) AS total_watch_seconds FROM oracle.entertainment_analytics.daily_streaming_trends ORDER BY event_date", {"event_date", "play_count", "total_watch_seconds"}, {{"2026-11-09", 13, 1912}, {"2026-11-10", 10, 2643}, {"2026-11-11", 14, 2950}, {"2026-11-12", 8, 3054}, {"2026-11-13", 12, 2680}, {"2026-11-14", 16, 1862}, {"2026-11-15", 6, 2818}}),
				    Typed = Table.TransformColumnTypes(Source, {{"event_date", type date}, {"play_count", Int64.Type}, {"total_watch_seconds", Int64.Type}}, "en-US")
				in Typed

	annotation PBI_ResultType = Table

