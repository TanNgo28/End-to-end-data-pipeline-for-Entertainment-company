model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation __PBI_TimeIntelligenceEnabled = 0

ref table 'Streaming KPIs'
ref table 'Daily Streaming'
ref table 'Top Content'
ref table 'Device Engagement'
ref table 'Content Completion'
